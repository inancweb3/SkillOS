{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillos.network/protocol/v0.1/evidence-envelope.schema.json",
  "title": "EvidenceEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "evidenceId",
    "manifestDigest",
    "subject",
    "provenance",
    "artifacts",
    "metrics",
    "createdAt"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "evidenceId": { "type": "string", "minLength": 1 },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["agent", "model", "skill", "human"]
        },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configDigest", "inputDigest"],
      "properties": {
        "codeCommit": { "type": "string" },
        "configDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "toolCatalogDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "modelId": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mediaType", "digest", "availability", "role"],
        "properties": {
          "mediaType": { "type": "string", "minLength": 1 },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "availability": {
            "type": "string",
            "enum": ["inline", "uri", "redacted"]
          },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "number" },
          { "type": "string" },
          { "type": "boolean" }
        ]
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "number" },
          { "type": "string" },
          { "type": "boolean" }
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "signature": { "type": "string" }
  }
}
