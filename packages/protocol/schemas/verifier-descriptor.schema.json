{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillos.network/protocol/v0.1/verifier-descriptor.schema.json",
  "title": "VerifierDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "id", "version", "digest", "capabilities"],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["deterministic", "staked", "hybrid"]
      }
    }
  }
}
