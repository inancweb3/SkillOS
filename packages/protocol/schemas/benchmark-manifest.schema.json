{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillos.network/protocol/v0.1/benchmark-manifest.schema.json",
  "title": "BenchmarkManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "benchmarkId",
    "benchmarkVersion",
    "taskType",
    "inputSchemaHash",
    "evaluator",
    "measurements",
    "hardFailureRules"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "benchmarkVersion": { "type": "string", "minLength": 1 },
    "taskType": { "type": "string", "minLength": 1 },
    "inputSchemaHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "timeoutDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "networkPolicyDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "valueType"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "unit": { "type": "string" },
          "higherIsBetter": { "type": "boolean" },
          "required": { "type": "boolean" },
          "valueType": {
            "type": "string",
            "enum": ["number", "boolean", "string"]
          }
        }
      }
    },
    "hardFailureRules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": { "type": "string" }
      }
    }
  }
}
